          <Description />
        </DisplayString>
        <DisplayString ElementID="##CompanyID##.##AppName##.##UniqueID##.Certificate.Expiration.Monitor" SubElementID="Success">
          <Name>Certificate Valid</Name>
        </DisplayString>
        <DisplayString ElementID="##CompanyID##.##AppName##.##UniqueID##.Certificate.Expiration.Monitor" SubElementID="Warning">
          <Name>Certificate Expiring Soon</Name>
        </DisplayString>
        <DisplayString ElementID="##CompanyID##.##AppName##.##UniqueID##.Certificate.Expiration.Monitor" SubElementID="Error">
          <Name>Certificate Expired Or Unreadable</Name>
        </DisplayString>
        <DisplayString ElementID="##CompanyID##.##AppName##.##UniqueID##.Certificate.Expiration.Monitor.AlertMessage">
          <Name>##CompanyID## ##AppName## ##UniqueID## certificate requires attention</Name>
          <Description>A monitored certificate is expiring, has expired, or could not be inspected.

Subject: {0}
Thumbprint: {1}
Store: {2}
Issuer: {3}
Expires (UTC): {4}
Days remaining: {5}
Warning threshold (days): {6}
Critical threshold (days): {7}
Computer: {9}

{8}</Description>
        </DisplayString>
      </DisplayStrings>
